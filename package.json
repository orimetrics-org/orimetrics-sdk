{
  "name": "@orimetrics/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent browser SDK for Orimetrics public APIs.",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "bun --bun tsdown --watch",
    "build": "bun --bun tsdown",
    "audit": "bun audit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "check": "bun run fmt:check && bun run lint && bun run typecheck",
    "test": "bun run build && bun test",
    "test:watch": "bun test --watch",
    "check:ci": "bun run audit && bun run check && bun run test",
    "prepare": "husky"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "husky": "9.1.7",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.93.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
